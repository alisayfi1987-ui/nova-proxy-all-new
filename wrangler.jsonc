{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-all-new",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3f26f76c-fff0-49ae-be32-91608257a76a","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5972f1bfc7a04f53b4dab459ba504a84" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
